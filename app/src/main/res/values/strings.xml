    <!-- Permission rationales (also surfaced in Help & FAQ) -->
    <string name="perm_notifications_title">Download progress alerts</string>
    <string name="perm_notifications_rationale">Allow notifications so The Lookbook can show model-pack download progress and completion. You can change this anytime in system Settings.</string>
    <string name="perm_camera_title">Camera for garment capture</string>
    <string name="perm_camera_rationale">Camera access lets you photograph a garment for try-on. You can always choose a photo from the system picker instead.</string>
    <string name="perm_storage_title">Durable storage</string>
    <string name="perm_storage_rationale">All-files access stores model packs and API keys under Documents/TheLookbook so they survive uninstall.</string>

